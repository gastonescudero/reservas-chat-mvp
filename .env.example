# Supabase (solo servidor; NUNCA con prefijo PUBLIC_)
# Si faltan, la app arranca en MODO DEMO (memoria, no persiste en Supabase).
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Contraseña de /admin (HTTP Basic: usuario cualquiera, esta contraseña).
# Obligatoria cuando Supabase está configurado.
ADMIN_PASSWORD=cambia-esto
